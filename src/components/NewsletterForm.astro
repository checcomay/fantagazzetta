---
// src/components/NewsletterForm.astro
---

<div class="subscribe-box">
  <h4>Rimani aggiornato sulla Fantagazzetta</h4>
  <p>Ricevi le analisi, le quote del weekend e i comunicati della lega direttamente via email.</p>
  
  <form id="subscribe-form">
    <input type="email" id="email-input" placeholder="La tua email..." required />
    <button type="submit">Iscriviti</button>
  </form>
  <span id="form-feedback"></span>
</div>

<script>
  const form = document.getElementById('subscribe-form');
  const feedback = document.getElementById('form-feedback');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('email-input').value;
    feedback.textContent = 'Salvataggio in corso...';
    feedback.style.color = '#777';

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          email,
          sorgente: 'footer_home'
        })
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Errore');

      feedback.textContent = 'Iscrizione registrata!';
      feedback.style.color = '#27ae60';
      form.reset();
    } catch (err) {
      feedback.textContent = 'Errore durante l\'iscrizione. Riprova.';
      feedback.style.color = '#c0392b';
    }
  });
</script>

<style>
  .subscribe-box {
    background: #1a1a1a;
    border: 1px solid #333;
    padding: 24px;
    border-radius: 8px;
    max-width: 480px;
    margin: 20px auto;
    text-align: center;
    color: #eee;
  }
  .subscribe-box h4 {
    margin: 0 0 8px 0;
    font-family: 'Helvetica', sans-serif;
    text-transform: uppercase;
    font-size: 1rem;
    letter-spacing: 0.5px;
  }
  .subscribe-box p {
    font-size: 0.85rem;
    color: #aaa;
    margin-bottom: 16px;
    font-family: 'Georgia', serif;
  }
  form {
    display: flex;
    gap: 8px;
  }
  input {
    flex: 1;
    padding: 10px 12px;
    border-radius: 4px;
    border: 1px solid #444;
    background: #111;
    color: #fff;
    font-size: 0.9rem;
  }
  button {
    background: #c0392b;
    color: #fff;
    border: none;
    padding: 10px 18px;
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
  }
  #form-feedback {
    display: block;
    margin-top: 10px;
    font-size: 0.8rem;
    font-family: 'Helvetica', sans-serif;
  }
</style>