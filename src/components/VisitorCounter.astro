---
// src/components/VisitorCounter.astro
---

<div class="visitor-counter">
  👀 Visite totali: <span id="visitor-count">--</span>
</div>

<script>
  function initCounter() {
    // Recupera le visite salvate o imposta un valore iniziale
    let visits = localStorage.getItem('fantamacri_visits');
    
    if (!visits) {
      visits = 0; // Valore di partenza personalizzabile
    } else {
      visits = parseInt(visits, 10) + 1;
    }
    
    // Salva il nuovo conteggio
    localStorage.setItem('fantamacri_visits', visits);
    
    // Mostra il valore formattato nel DOM
    const counterSpan = document.getElementById('visitor-count');
    if (counterSpan) {
      counterSpan.textContent = visits.toLocaleString();
    }
  }

  initCounter();
</script>

<style>
  .visitor-counter {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 0.85rem;
    color: #aaa;
    text-align: center;
    margin-top: 10px;
  }
</style>