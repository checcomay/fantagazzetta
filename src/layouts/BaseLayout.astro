---
const { pageTitle } = Astro.props;
---
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} - La Fantagazzetta di Macrì</title>
    <style is:global>
      body {
        background-color: #fcfcfc;
        font-family: 'Georgia', serif;
        color: #222;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px 40px;
        background-color: #fff;
        /* Impedisce a qualsiasi elemento interno di allargare il contenitore */
        overflow-wrap: break-word; 
        box-sizing: border-box;
      }
      
      /* REGOLE DI FERRO PER LE IMMAGINI */
      img {
        max-width: 100% !important;
        height: auto !important;
        box-sizing: border-box !important;
        display: block;
      }

      /* Stili della testata */
      .site-header {
        text-align: center;
        margin-bottom: 30px;
      }
      .site-header a {
        text-decoration: none;
        color: #111;
      }
      .site-header h1 {
        font-family: 'Georgia', serif;
        font-size: 3.8rem;
        text-transform: uppercase;
        margin: 0 0 10px 0;
        letter-spacing: -1px;
      }
      .subtitle-container {
        border-top: 1px solid #111;
        border-bottom: 1px solid #111;
        padding: 5px 0;
        margin: 0 auto;
      }
      .site-subtitle {
        font-family: 'Helvetica', 'Arial', sans-serif;
        font-size: 0.9rem;
        text-transform: uppercase;
        font-weight: bold;
        letter-spacing: 1px;
        margin: 0;
      }
      main {
        border-top: 3px solid #111;
        padding-top: 30px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <a href="/">
          <h1>La Fantagazzetta di Macrì</h1>
        </a>
        <div class="subtitle-container">
          <p class="site-subtitle">Il quotidiano ufficiale della lega Fantamacrì</p>
        </div>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>