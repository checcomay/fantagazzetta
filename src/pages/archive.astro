import BaseLayout from '../layouts/BaseLayout.astro';
import archiveData from '../data/archive.json';

// Helper per mostrare '-' quando un campo opzionale è assente o vuoto
function formatCell(val) {
  if (val === undefined || val === null || String(val).trim() === '') {
    return '-';
  }
  return val;
}

// Ordina le stagioni dalla più recente alla più vecchia
const seasons = [...archiveData].sort((a, b) => b.stagione.localeCompare(a.stagione));

// Anno / stagione di inizio storico (calcolata automaticamente dalla stagione più vecchia nel JSON)
const firstSeason = seasons.length > 0 ? seasons[seasons.length - 1].stagione : null;
const startYear = firstSeason ? String(firstSeason).split('/')[0].trim() : null;

// --- AGGREGAZIONE MEDAGLIERE PER ALLENATORE ---
const coachesMap = new Map();

function ensureCoach(name) {
  const coachName = String(name).trim();
  if (!coachName) return null;

  if (!coachesMap.has(coachName)) {
    coachesMap.set(coachName, {
      nome: coachName,
      ori: 0,
      argenti: 0,
      bronzi: 0,
      podi: 0,
      cucchiai: 0,
      stagioni: 0,
      sommaPunti: 0,
      stagioniConPunti: 0,
      anniVinti: [],
      squadreStoriche: new Set()
    });
  }
  return coachesMap.get(coachName);
}

for (const season of seasons) {
  const sortedStandings = [...(season.classifica || [])].sort(
    (a, b) => Number(a.posizione) - Number(b.posizione)
  );

  // Determina l'ultima posizione per assegnare automaticamente il Cucchiaio di Legno
  const maxPos =
    sortedStandings.length > 1
      ? Math.max(...sortedStandings.map((r) => Number(r.posizione)))
      : -1;
  const hasExplicitSpoon = sortedStandings.some((r) => r.cucchiaioDiLegno === true);

  for (const row of sortedStandings) {
    const pos = Number(row.posizione);
    const isSpoon = hasExplicitSpoon
      ? row.cucchiaioDiLegno === true
      : maxPos > 0 && pos === maxPos;

    const coachesList = Array.isArray(row.allenatori)
      ? row.allenatori
      : row.allenatori
      ? [row.allenatori]
      : [];

    for (const rawCoach of coachesList) {
      const c = ensureCoach(rawCoach);
      if (!c) continue;

      c.stagioni += 1;
      if (row.squadra) c.squadreStoriche.add(row.squadra);

      if (
        row.punti !== undefined &&
        row.punti !== null &&
        String(row.punti).trim() !== '' &&
        !isNaN(Number(row.punti))
      ) {
        c.sommaPunti += Number(row.punti);
        c.stagioniConPunti += 1;
      }

      if (pos === 1) {
        c.ori += 1;
        c.podi += 1;
        c.anniVinti.push(season.stagione);
      } else if (pos === 2) {
        c.argenti += 1;
        c.podi += 1;
      } else if (pos === 3) {
        c.bronzi += 1;
        c.podi += 1;
      }

      if (isSpoon) {
        c.cucchiai += 1;
      }
    }
  }
}

// Trasforma la mappa in array e ordina (Ori -> Argenti -> Bronzi -> Media Punti)
const medagliere = Array.from(coachesMap.values())
  .map((c) => ({
    ...c,
    mediaPunti:
      c.stagioniConPunti > 0
        ? Number((c.sommaPunti / c.stagioniConPunti).toFixed(2))
        : null,
    squadreArray: Array.from(c.squadreStoriche)
  }))
  .sort((a, b) => {
    if (b.ori !== a.ori) return b.ori - a.ori;
    if (b.argenti !== a.argenti) return b.argenti - a.argenti;
    if (b.bronzi !== a.bronzi) return b.bronzi - a.bronzi;
    return (b.mediaPunti ?? -1) - (a.mediaPunti ?? -1);
  });

// --- CALCOLO PREMI SPECIALI (GESTIONE PARI MERITO) ---
const maxOri = medagliere.length ? Math.max(...medagliere.map((c) => c.ori)) : 0;
const topWinners = maxOri > 0 ? medagliere.filter((c) => c.ori === maxOri) : [];

const maxPodi = medagliere.length ? Math.max(...medagliere.map((c) => c.podi)) : 0;
const topPodiums = maxPodi > 0 ? medagliere.filter((c) => c.podi === maxPodi) : [];

const maxCucchiai = medagliere.length ? Math.max(...medagliere.map((c) => c.cucchiai)) : 0;
const topSpoons = maxCucchiai > 0 ? medagliere.filter((c) => c.cucchiai === maxCucchiai) : [];

// Miglior Media Punti (privilegia chi ha almeno 2 stagioni se l'archivio ha più stagioni)
const coachesWithPoints = medagliere.filter((c) => c.mediaPunti !== null);
const eligibleAvgPoints =
  seasons.length > 1
    ? coachesWithPoints.filter((c) => c.stagioniConPunti >= 2)
    : coachesWithPoints;
const avgPointsPool = eligibleAvgPoints.length ? eligibleAvgPoints : coachesWithPoints;
const bestAvgPoints = avgPointsPool.length
  ? Math.max(...avgPointsPool.map((c) => c.mediaPunti))
  : 0;
const topAvgPoints =
  bestAvgPoints > 0 ? avgPointsPool.filter((c) => c.mediaPunti === bestAvgPoints) : [];
---

<BaseLayout pageTitle="Archivio Storico & Albo d'Oro">
  <div class="archive-page">
    <div class="header-section">
      <h2 class="main-title">ARCHIVIO STORICO</h2>
      <p class="subtitle">Albo d'oro degli allenatori e classifiche di tutte le edizioni</p>
      {firstSeason && (
        <div class="archive-since-label">
          📅 Dati storici raccolti dal <strong>{startYear}</strong>
          {firstSeason !== startYear && <span> (stagione {firstSeason})</span>}
        </div>
      )}
    </div>

    <!-- CARD RECORD STORICI -->
    {medagliere.length > 0 && (
      <section class="records-grid">
        <div class="record-card gold">
          <span class="record-emoji">👑</span>
          <span class="record-label">Il Re del Fantamacrì</span>
          <div class="record-names">
            {topWinners.length > 0 ? topWinners.map((c) => c.nome).join(' • ') : 'Nessuno'}
          </div>
          <div class="record-stat">
            {maxOri} {maxOri === 1 ? 'Scudetto' : 'Scudetti'}
          </div>
        </div>

        <div class="record-card podium">
          <span class="record-emoji">🏅</span>
          <span class="record-label">Abbonato al Podio</span>
          <div class="record-names">
            {topPodiums.length > 0 ? topPodiums.map((c) => c.nome).join(' • ') : 'Nessuno'}
          </div>
          <div class="record-stat">
            {maxPodi} {maxPodi === 1 ? 'Podio' : 'Podi'} in carriera
          </div>
        </div>

        <div class="record-card avg-points">
          <span class="record-emoji">⚡</span>
          <span class="record-label">Miglior Media Punti</span>
          <div class="record-names">
            {topAvgPoints.length > 0 ? topAvgPoints.map((c) => c.nome).join(' • ') : 'Nessuno'}
          </div>
          <div class="record-stat">
            {bestAvgPoints > 0 ? `${bestAvgPoints} pt / stagione` : '-'}
          </div>
        </div>

        <div class="record-card spoon">
          <span class="record-emoji">🥄</span>
          <span class="record-label">Cucchiaio di Legno</span>
          <div class="record-names">
            {topSpoons.length > 0 ? topSpoons.map((c) => c.nome).join(' • ') : 'Nessuno'}
          </div>
          <div class="record-stat">
            {maxCucchiai} {maxCucchiai === 1 ? 'ultimo posto' : 'ultimi posti'}
          </div>
        </div>
      </section>
    )}

    <!-- MEDAGLIERE ALLENATORI -->
    <section class="archive-section">
      <div class="section-header">
        <h3>🏛️ ALBO D'ORO & MEDAGLIERE ALLENATORI</h3>
        <span class="section-note">Clicca sulle colonne per ordinare il medagliere</span>
      </div>

      <div class="table-wrapper">
        <table class="archive-table" id="medagliere-table">
          <thead>
            <tr>
              <th>#</th>
              <th class="left-col">Allenatore & storico squadre</th>
              <th data-sort="ori" class="sortable active-sort" title="Ordina per Titoli (1° posto)">🥇 1° ↕</th>
              <th data-sort="argenti" class="sortable" title="Ordina per 2° posto">🥈 2° ↕</th>
              <th data-sort="bronzi" class="sortable" title="Ordina per 3° posto">🥉 3° ↕</th>
              <th data-sort="podi" class="sortable" title="Ordina per Podi Totali">🏅 ↕</th>
              <th data-sort="cucchiai" class="sortable" title="Ordina per Cucchiai di Legno">🥄 ↕</th>
              <th data-sort="stagioni" class="sortable" title="Ordina per Stagioni giocate">n ↕</th>
              <th data-sort="mediapunti" class="sortable" title="Ordina per Media Punti a stagione">Media Pt ↕</th>
            </tr>
          </thead>
          <tbody id="medagliere-body">
            {medagliere.map((coach, idx) => (
              <tr
                data-ori={coach.ori}
                data-argenti={coach.argenti}
                data-bronzi={coach.bronzi}
                data-podi={coach.podi}
                data-cucchiai={coach.cucchiai}
                data-stagioni={coach.stagioni}
                data-mediapunti={coach.mediaPunti ?? -1}
              >
                <td class="rank-cell">{idx + 1}</td>
                <td class="left-col">
                  <div class="coach-name-row">
                    <strong>{coach.nome}</strong>
                    {coach.anniVinti.length > 0 && (
                      <span class="titles-tag" title={`Scudetti: ${coach.anniVinti.join(', ')}`}>
                        ★ {coach.anniVinti.join(', ')}
                      </span>
                    )}
                  </div>
                  <div class="coach-teams-history">
                    <strong>Squadre:</strong> {coach.squadreArray.join(' · ')}
                  </div>
                </td>
                <td class="medal-cell gold-text">{coach.ori}</td>
                <td class="medal-cell silver-text">{coach.argenti}</td>
                <td class="medal-cell bronze-text">{coach.bronzi}</td>
                <td class="podi-cell"><strong>{coach.podi}</strong></td>
                <td class="spoon-cell">{coach.cucchiai}</td>
                <td>{coach.stagioni}</td>
                <td class="avg-cell">{coach.mediaPunti !== null ? coach.mediaPunti : '-'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- CLASSIFICHE STORICHE PER STAGIONE -->
    <section class="archive-section">
      <div class="section-header">
        <h3>📜 CLASSIFICHE DELLE STAGIONI PRECEDENTI</h3>
        <div class="season-tabs" id="season-tabs">
          <button class="season-tab active" data-season="ALL">Tutte</button>
          {seasons.map((s) => (
            <button class="season-tab" data-season={s.stagione}>{s.stagione}</button>
          ))}
        </div>
      </div>

      <div class="seasons-list">
        {seasons.map((season) => {
          const sortedRows = [...(season.classifica || [])].sort(
            (a, b) => Number(a.posizione) - Number(b.posizione)
          );
          const maxPos =
            sortedRows.length > 1
              ? Math.max(...sortedRows.map((r) => Number(r.posizione)))
              : -1;
          const hasExplicitSpoon = sortedRows.some((r) => r.cucchiaioDiLegno === true);

          return (
            <article class="season-card" data-season-card={season.stagione}>
              <div class="season-card-header">
                <h4>Stagione {season.stagione}</h4>
                {season.note && <span class="season-note">{season.note}</span>}
              </div>

              <div class="table-wrapper">
                <table class="archive-table">
                  <thead>
                    <tr>
                      <th>Pos</th>
                      <th class="left-col">Squadra</th>
                      <th class="left-col">Allenatore/i</th>
                      <th>Pt</th>
                      <th>V-P-S</th>
                      <th>GF:GS</th>
                      <th>Pt. Tot</th>
                    </tr>
                  </thead>
                  <tbody>
                    {sortedRows.map((row) => {
                      const pos = Number(row.posizione);
                      const isSpoon = hasExplicitSpoon
                        ? row.cucchiaioDiLegno === true
                        : maxPos > 0 && pos === maxPos;
                      const posClass =
                        pos === 1
                          ? 'podium-1'
                          : pos === 2
                          ? 'podium-2'
                          : pos === 3
                          ? 'podium-3'
                          : isSpoon
                          ? 'spoon-row'
                          : '';
                      const rankIcon =
                        pos === 1
                          ? '🥇'
                          : pos === 2
                          ? '🥈'
                          : pos === 3
                          ? '🥉'
                          : isSpoon
                          ? '🥄'
                          : pos;
                      const logoPath = row.logo || `/logos/${row.squadra}.png`;
                      const coaches = Array.isArray(row.allenatori)
                        ? row.allenatori
                        : row.allenatori
                        ? [row.allenatori]
                        : [];
                      const vpsValue = formatCell(row.vps ?? row.ops);
                      const gfGsValue = formatCell(row.gfGs);

                      return (
                        <tr class={posClass}>
                          <td class="rank-cell" title={isSpoon ? 'Cucchiaio di Legno' : `${pos}° posto`}>
                            {rankIcon}
                          </td>
                          <td class="left-col">
                            <div class="team-cell">
                              <img
                                src={logoPath}
                                alt={row.squadra}
                                class="team-logo"
                                onerror="this.style.display='none'"
                              />
                              <strong>{row.squadra}</strong>
                            </div>
                          </td>
                          <td class="left-col">
                            <div class="coaches-badges">
                              {coaches.map((name) => (
                                <span class="coach-pill">{name}</span>
                              ))}
                            </div>
                          </td>
                          <td class="points-cell"><strong>{formatCell(row.punti)}</strong></td>
                          <td class="muted-cell">{vpsValue}</td>
                          <td class="muted-cell">{gfGsValue}</td>
                          <td class="tot-cell">{formatCell(row.puntiTotali)}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // --- 1. FILTRO STAGIONI ---
  const tabs = document.querySelectorAll('.season-tab');
  const cards = document.querySelectorAll('.season-card');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-season');
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      cards.forEach((card) => {
        const cardSeason = card.getAttribute('data-season-card');
        if (target === 'ALL' || cardSeason === target) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // --- 2. ORDINAMENTO INTERATTIVO DEL MEDAGLIERE ---
  const tbody = document.getElementById('medagliere-body');
  const sortHeaders = document.querySelectorAll('#medagliere-table th[data-sort]');
  let currentSort = 'ori';
  let isDesc = true;

  sortHeaders.forEach((th) => {
    th.addEventListener('click', () => {
      const key = th.getAttribute('data-sort');
      if (!key || !tbody) return;

      if (currentSort === key) {
        isDesc = !isDesc;
      } else {
        currentSort = key;
        isDesc = true;
      }

      sortHeaders.forEach((h) => h.classList.remove('active-sort'));
      th.classList.add('active-sort');

      const rows = Array.from(tbody.querySelectorAll('tr'));
      rows.sort((a, b) => {
        const valA = Number(a.getAttribute(`data-${key}`));
        const valB = Number(b.getAttribute(`data-${key}`));
        if (valA !== valB) return isDesc ? valB - valA : valA - valB;

        // Spareggio secondario: Ori -> Podi -> Media Punti
        const oriDiff = Number(b.getAttribute('data-ori')) - Number(a.getAttribute('data-ori'));
        if (oriDiff !== 0) return oriDiff;
        const podiDiff = Number(b.getAttribute('data-podi')) - Number(a.getAttribute('data-podi'));
        if (podiDiff !== 0) return podiDiff;
        return Number(b.getAttribute('data-mediapunti')) - Number(a.getAttribute('data-mediapunti'));
      });

      rows.forEach((row, index) => {
        const rankCell = row.querySelector('.rank-cell');
        if (rankCell) rankCell.textContent = String(index + 1);
        tbody.appendChild(row);
      });
    });
  });
</script>

