---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout pageTitle="Home">
  <div class="articles-list" id="articles-container">
    {sortedArticles.map((article, index) => (
      <article class={`article-row ${index >= 8 ? 'archive-item hidden' : ''}`}>
        
        <div class="article-image">
          {article.data.image ? (
            <img src={article.data.image} alt="Copertina" />
          ) : (
            <div class="placeholder-image">Foto Archivio</div>
          )}
        </div>
        
        <div class="article-content">
          <span class="matchday">{article.data.matchday}</span>
          <h2><a href={`/article/${article.id}`}>{article.data.title}</a></h2>
          <p class="summary summary-clamp">{article.data.subtitle}</p>
          
          <a href={`/article/${article.id}`} class="read-btn">Leggi l'edizione</a>
        </div>
      </article>
    ))}
  </div>

  {sortedArticles.length > 8 && (
    <div class="archive-toggle-container">
      <button id="toggle-archive-btn" class="archive-btn">Visualizza archivio</button>
    </div>
  )}
</BaseLayout>

<script>
  const btn = document.getElementById('toggle-archive-btn');
  
  if (btn) {
    btn.addEventListener('click', () => {
      const hiddenItems = document.querySelectorAll('.archive-item');
      
      // Controlliamo lo stato usando una classe anziché il testo (per evitare problemi con l'uppercase del CSS)
      const isExpanded = btn.classList.contains('is-expanded');
      
      if (isExpanded) {
        // Se è aperto, nascondi gli elementi
        hiddenItems.forEach(item => item.classList.add('hidden'));
        btn.innerText = 'Visualizza archivio';
        btn.classList.remove('is-expanded');
      } else {
        // Se è chiuso, mostra gli elementi
        hiddenItems.forEach(item => item.classList.remove('hidden'));
        btn.innerText = 'Nascondi';
        btn.classList.add('is-expanded');
      }
    });
  }
</script>

<style>
  .articles-list {
    display: flex;
    flex-direction: column;
  }
  
  .article-row {
    display: flex;
    gap: 30px;
    padding: 30px 0;
    border-bottom: 1px solid #eaeaea;
  }

  .archive-item.hidden {
    display: none;
  }
  
  .article-image {
    flex: 0 0 350px;
    height: 220px;
  }
  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid #ccc;
  }
  .placeholder-image {
    width: 100%;
    height: 100%;
    background-color: #ededed;
    border: 1px solid #777;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 1.8rem;
    color: #222;
  }
  
  .article-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  
  .matchday {
    font-family: 'Helvetica', 'Arial', sans-serif;
    color: #c0392b;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 5px;
  }
  
  .article-content h2 {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 1.6rem;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 10px 0;
    line-height: 1.1;
  }
  
  .article-content h2 a {
    color: #111;
    text-decoration: none;
  }
  .article-content h2 a:hover {
    text-decoration: underline;
  }
  
  .summary {
    font-family: 'Georgia', serif;
    font-size: 1.1rem;
    color: #333;
    line-height: 1.4;
    margin: 0 0 20px 0;
  }

  .summary-clamp {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .read-btn {
    align-self: flex-start;
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-weight: 800;
    color: #c0392b;
    text-transform: uppercase;
    text-decoration: none;
    font-size: 0.9rem;
    padding: 8px 16px;
    border: 1px solid #c0392b;
    transition: all 0.2s ease;
  }
  
  .read-btn:hover {
    background-color: #c0392b;
    color: #fff;
  }

  .archive-toggle-container {
    text-align: center;
    margin-top: 40px;
    padding-bottom: 20px;
  }
  
  .archive-btn {
    background-color: #111;
    color: #fff;
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 1rem;
    padding: 15px 30px;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .archive-btn:hover {
    background-color: #c0392b;
  }
  
  @media (max-width: 768px) {
    .article-row {
      flex-direction: column;
    }
    .article-image {
      flex: none;
      width: 100%;
      height: auto;
      aspect-ratio: 16/9;
    }
  }
</style>
