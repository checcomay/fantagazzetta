---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout pageTitle="Home">
  <div class="articles-list">
    {sortedArticles.map((article) => (
      <article class="article-row">
        <!-- Lato Sinistro: Immagine -->
        <div class="article-image">
          {article.data.image ? (
            <img src={article.data.image} alt="Copertina" />
          ) : (
            <div class="placeholder-image">Foto Archivio</div>
          )}
        </div>
        
        <!-- Lato Destro: Contenuto -->
        <div class="article-content">
          <span class="matchday">{article.data.matchday}</span>
          <h2><a href={`/article/${article.id}`}>{article.data.title}</a></h2>
          <p class="summary">{article.data.subtitle}</p>
          
          <a href={`/article/${article.id}`} class="read-btn">Leggi l'edizione</a>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .articles-list {
    display: flex;
    flex-direction: column;
  }
  
  .article-row {
    display: flex;
    gap: 30px;
    padding: 30px 0;
    border-bottom: 1px solid #eaeaea;
  }
  
  .article-image {
    flex: 0 0 350px;
    height: 220px;
  }
  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid #ccc;
  }
  .placeholder-image {
    width: 100%;
    height: 100%;
    background-color: #ededed;
    border: 1px solid #777;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 1.8rem;
    color: #222;
  }
  
  /* Stile Testo */
  .article-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  
  .matchday {
    font-family: 'Helvetica', 'Arial', sans-serif;
    color: #c0392b; /* Rosso */
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 5px;
  }
  
  .article-content h2 {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 2rem;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 10px 0;
    line-height: 1.1;
  }
  
  .article-content h2 a {
    color: #111;
    text-decoration: none;
  }
  .article-content h2 a:hover {
    text-decoration: underline;
  }
  
  .summary {
    font-family: 'Georgia', serif;
    font-size: 1.1rem;
    color: #333;
    line-height: 1.5;
    margin: 0 0 20px 0;
  }
  
  /* Bottone LEGGI L'EDIZIONE */
  .read-btn {
    align-self: flex-start;
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-weight: 800;
    color: #c0392b;
    text-transform: uppercase;
    text-decoration: none;
    font-size: 0.9rem;
    padding: 8px 16px;
    border: 1px solid #c0392b;
    transition: all 0.2s ease;
  }
  
  .read-btn:hover {
    background-color: #c0392b;
    color: #fff;
  }
  
  /* Adattamento per dispositivi mobili */
  @media (max-width: 768px) {
    .article-row {
      flex-direction: column;
    }
    .article-image {
      flex: none;
      width: 100%;
      height: auto;
      aspect-ratio: 16/9;
    }
  }
  
</style>