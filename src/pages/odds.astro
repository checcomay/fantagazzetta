<script>
  let selectedBets = [];

  const toggleBtn = document.getElementById('slip-toggle');
  const dropdown = document.getElementById('slip-dropdown');
  const arrow = document.getElementById('slip-arrow');
  const countBadge = document.getElementById('slip-count-badge');
  const headerOdd = document.getElementById('slip-header-odd');
  const headerCredits = document.getElementById('header-user-credits');
  const itemsList = document.getElementById('slip-items-list');
  const summaryBlock = document.getElementById('slip-summary');
  const summaryMultiplier = document.getElementById('summary-multiplier');
  const summaryWin = document.getElementById('summary-win');
  const stakeInput = document.getElementById('bet-stake');
  const emailInput = document.getElementById('bettor-email');
  const submitBtn = document.getElementById('submit-bet-btn');
  const feedback = document.getElementById('bet-feedback');

  const historyEmailInput = document.getElementById('history-email-input');
  const loadHistoryBtn = document.getElementById('load-history-btn');
  const historyContentArea = document.getElementById('history-content-area');

  // Recupera email salvata
  const savedEmail = localStorage.getItem('fantamacri_user_email') || '';
  if (savedEmail) {
    if (emailInput) emailInput.value = savedEmail;
    if (historyEmailInput) historyEmailInput.value = savedEmail;
    fetchUserHistory(savedEmail);
  }

  toggleBtn?.addEventListener('click', () => {
    const isClosed = dropdown.style.display === 'none';
    dropdown.style.display = isClosed ? 'block' : 'none';
    if (arrow) arrow.textContent = isClosed ? '▲' : '▼';
  });

  // Ricalcola la vincita potenziale quando cambia la puntata
  stakeInput?.addEventListener('input', updateSlipUI);

  // Selezione Quote con data-market non esclusivo
  document.querySelectorAll('.bet-pick').forEach((box) => {
    box.addEventListener('click', () => {
      const match = box.getAttribute('data-match');
      const market = box.getAttribute('data-market');
      const pick = box.getAttribute('data-pick');
      const odd = parseFloat(box.getAttribute('data-odd'));

      if (isNaN(odd) || odd <= 1.0) return;

      const exactIndex = selectedBets.findIndex(
        (b) => b.match === match && b.market === market && b.pick === pick
      );

      if (exactIndex > -1) {
        selectedBets.splice(exactIndex, 1);
        box.classList.remove('selected-bet');
      } else {
        const conflictIndex = selectedBets.findIndex(
          (b) => b.match === match && b.market === market
        );

        if (conflictIndex > -1) {
          const prevPick = selectedBets[conflictIndex].pick;
          document.querySelectorAll(
            `.bet-pick[data-match="${match}"][data-pick="${prevPick}"]`
          ).forEach((el) => el.classList.remove('selected-bet'));
          selectedBets.splice(conflictIndex, 1);
        }

        selectedBets.push({ match, market, pick, odd });
        box.classList.add('selected-bet');

        if (dropdown && dropdown.style.display === 'none') {
          dropdown.style.display = 'block';
          if (arrow) arrow.textContent = '▲';
        }
      }

      updateSlipUI();
    });
  });

  function updateSlipUI() {
    if (!countBadge || !headerOdd || !itemsList || !summaryBlock) return;

    countBadge.textContent = `${selectedBets.length} ${selectedBets.length === 1 ? 'giocata' : 'giocate'}`;

    if (selectedBets.length === 0) {
      itemsList.innerHTML = '<p class="empty-slip-text">Nessun pronostico selezionato. Clicca sulle quote della giornata per iniziare!</p>';
      summaryBlock.style.display = 'none';
      headerOdd.textContent = 'Quota: 1.00';
      return;
    }

    summaryBlock.style.display = 'block';

    const totalOdd = selectedBets.reduce((acc, curr) => acc * curr.odd, 1);
    const formattedOdd = totalOdd.toFixed(2);
    headerOdd.textContent = `Quota: ${formattedOdd}`;
    if (summaryMultiplier) summaryMultiplier.textContent = formattedOdd;

    const currentStake = Math.max(1, parseFloat(stakeInput?.value || 10));
    const winAmount = (totalOdd * currentStake).toFixed(2);
    if (summaryWin) summaryWin.textContent = `${winAmount} crediti`;

    // FIX NOME PARTITA BEN VISIBILE IN BIANCO
    itemsList.innerHTML = selectedBets.map((item, idx) => `
      <div class="slip-item-row">
        <div class="slip-item-left">
          <strong class="slip-match-title">${item.match}</strong>
          <div class="slip-item-market">Esito: <span>${item.pick}</span></div>
        </div>
        <div class="slip-item-action">
          <span class="slip-item-odd">${item.odd.toFixed(2)}</span>
          <button type="button" class="remove-item-btn" data-remove-index="${idx}">✕</button>
        </div>
      </div>
    `).join('');

    document.querySelectorAll('.remove-item-btn').forEach((delBtn) => {
      delBtn.addEventListener('click', () => {
        const removeIdx = parseInt(delBtn.getAttribute('data-remove-index'), 10);
        const removed = selectedBets.splice(removeIdx, 1)[0];

        document.querySelectorAll(
          `.bet-pick[data-match="${removed.match}"][data-pick="${removed.pick}"]`
        ).forEach((b) => b.classList.remove('selected-bet'));

        updateSlipUI();
      });
    });
  }

  // Invio Schedina
  submitBtn?.addEventListener('click', async () => {
    const email = emailInput ? emailInput.value.trim() : '';
    const stake = parseFloat(stakeInput?.value || 10);

    if (!email || !email.includes('@')) {
      if (feedback) {
        feedback.textContent = 'Inserisci un indirizzo email valido.';
        feedback.className = 'bet-feedback error';
      }
      return;
    }

    localStorage.setItem('fantamacri_user_email', email);
    if (historyEmailInput) historyEmailInput.value = email;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Salvataggio in corso...';
    if (feedback) feedback.textContent = '';

    const payload = {
      email,
      bet: {
        puntata: stake,
        moltiplicatore_totale: parseFloat(summaryMultiplier?.textContent || '1.00'),
        selections: selectedBets
      }
    };

    try {
      const res = await fetch('/api/save-bet', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await res.json();
      if (!res.ok) throw new Error(result.error || 'Errore nel salvataggio');

      if (feedback) {
        feedback.textContent = `🎉 Schedina registrata! Crediti residui: ${result.newCredits}`;
        feedback.className = 'bet-feedback success';
      }

      if (headerCredits) headerCredits.textContent = `💰 Crediti: ${result.newCredits}`;

      setTimeout(() => {
        selectedBets = [];
        document.querySelectorAll('.bet-pick').forEach((b) => b.classList.remove('selected-bet'));
        updateSlipUI();
        if (feedback) feedback.textContent = '';
        submitBtn.disabled = false;
        submitBtn.textContent = 'REGISTRA SCHEDINA';
        fetchUserHistory(email);
      }, 2000);

    } catch (err) {
      if (feedback) {
        feedback.textContent = `Errore: ${err.message}`;
        feedback.className = 'bet-feedback error';
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'REGISTRA SCHEDINA';
    }
  });

  // Caricamento Storico Pronostici
  loadHistoryBtn?.addEventListener('click', () => {
    const email = historyEmailInput?.value.trim();
    if (email) {
      localStorage.setItem('fantamacri_user_email', email);
      fetchUserHistory(email);
    }
  });

  async function fetchUserHistory(email) {
    if (!historyContentArea) return;
    historyContentArea.innerHTML = '<p class="empty-history-text">Caricamento e verifica pronostici in corso...</p>';

    try {
      const res = await fetch(`/api/my-bets?email=${encodeURIComponent(email)}`);
      const data = await res.json();

      if (!res.ok) throw new Error(data.error || 'Impossibile recuperare lo storico');

      if (headerCredits) headerCredits.textContent = `💰 Crediti: ${data.credits}`;

      if (!data.bets || data.bets.length === 0) {
        historyContentArea.innerHTML = `
          <div class="user-summary-card">
            <span>Utente: <strong>${email}</strong></span>
            <span class="user-balance-tag">💰 Crediti disponibili: <strong>${data.credits}</strong></span>
          </div>
          <p class="empty-history-text">Non hai ancora giocato nessuna schedina. Crea la tua prima giocata in alto!</p>
        `;
        return;
      }

      historyContentArea.innerHTML = `
        <div class="user-summary-card">
          <div class="user-info">
            <span class="user-label">ACCOUNT:</span>
            <strong class="user-email">${email}</strong>
          </div>
          <div class="user-balance-tag">
            💰 Crediti disponibili: <strong>${data.credits}</strong>
          </div>
        </div>

        <div class="history-bets-list">
          ${data.bets.map((b) => {
            const dateStr = new Date(b.data_giocata).toLocaleString('it-IT', { 
              day: '2-digit', 
              month: 'short', 
              hour: '2-digit', 
              minute: '2-digit' 
            });

            // Assegnazione stato ed emoji
            let statusClass = 'status-pending';
            let statusLabel = 'IN CORSO';
            let statusEmoji = '⏳';

            if (b.status === 'vinta') {
              statusClass = 'status-won';
              statusLabel = 'VINCENTE';
              statusEmoji = '✅';
            } else if (b.status === 'persa') {
              statusClass = 'status-lost';
              statusLabel = 'PERDENTE';
              statusEmoji = '❌';
            }

            return `
              <div class="history-card ${statusClass}">
                <div class="history-card-header">
                  <div class="history-header-left">
                    <span class="history-date">📅 ${dateStr}</span>
                    <span class="history-stake">Puntata: <strong>${b.puntata} crediti</strong></span>
                    <span class="history-odd">Quota: <strong>${Number(b.moltiplicatore_totale).toFixed(2)}</strong></span>
                  </div>
                  <div class="history-header-right">
                    <div class="history-status-badge ${statusClass}">
                      <span class="status-emoji">${statusEmoji}</span>
                      <span class="status-text">${statusLabel}</span>
                    </div>
                  </div>
                </div>

                <div class="history-selections">
                  ${(b.selections || []).map(s => {
                    let selEmoji = '⏳';
                    let selText = 'In attesa';
                    let selClass = 'tag-pending';

                    if (s.status === 'vinta') {
                      selEmoji = '✅';
                      selText = 'Preso';
                      selClass = 'tag-won';
                    } else if (s.status === 'persa') {
                      selEmoji = '❌';
                      selText = 'Sbagliato';
                      selClass = 'tag-lost';
                    }

                    return `
                      <div class="history-sel-item">
                        <div class="history-sel-info">
                          <strong class="history-sel-match">${s.match}</strong>
                          <span class="history-sel-pick">Esito: <b>${s.pick}</b> <small>(Quota: ${Number(s.odd).toFixed(2)})</small></span>
                        </div>
                        <div class="history-sel-result">
                          <span class="history-real-score">Risultato: <b>${s.risultato_reale || 'Da disputare'}</b></span>
                          <span class="sel-tag ${selClass}">
                            ${selEmoji} ${selText}
                          </span>
                        </div>
                      </div>
                    `;
                  }).join('')}
                </div>

                <div class="history-card-footer">
                  <div class="win-box">
                    <span>Potenziale Vincita:</span>
                    <strong class="win-val">${Number(b.potenziale_vincita).toFixed(2)} crediti</strong>
                  </div>
                  ${b.status === 'vinta' ? '<span class="won-payout-tag">🎉 Vincita accreditata sul conto</span>' : ''}
                </div>
              </div>
            `;
          }).join('')}
        </div>
      `;
    } catch (e) {
      historyContentArea.innerHTML = `<p class="empty-history-text error-msg">Errore: ${e.message}</p>`;
    }
  }
</script>

