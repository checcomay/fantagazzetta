---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import calendarData from '../data/calendar.json';
import xFMsData from '../data/xFMs.json';

// 1. CONTROLLO DATA DI ULTIMA MODIFICA DI xFMs.json
const xfmFilePath = path.resolve(process.cwd(), 'src/data/xFMs.json');
let lastModifiedDate = new Date();
let isDataStale = false;
let daysOld = 0;

try {
  const stats = fs.statSync(xfmFilePath);
  lastModifiedDate = stats.mtime;
  const diffMs = Date.now() - lastModifiedDate.getTime();
  daysOld = Math.floor(diffMs / (1000 * 60 * 60 * 24));
  isDataStale = daysOld >= 4;
} catch (e) {
  isDataStale = true;
}

const formattedLastUpdate = lastModifiedDate.toLocaleDateString('it-IT', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
});

// 2. INDIVIDUAZIONE PRIMA GIORNATA NON ANCORA GIOCATA
const nextRoundObj = calendarData.rounds?.find((r) =>
  r.matches.some((m) => !m.played)
) || calendarData.rounds?.[0];

// Mappa rapida: nome squadra -> dati xFM
const teamXfmMap = new Map();
for (const team of xFMsData) {
  teamXfmMap.set(team.fantasy_team.toLowerCase().trim(), team);
}

// 3. SELEZIONE TITOLARI 4-3-3 E CALCOLO MEDIA + BONUS DIFESA (+1.5)
const DEFENSE_BONUS = 1.5;

function getBest433Lineup(roster = []) {
  const pick = (role, count) =>
    roster
      .filter((p) => (p.role || '').toUpperCase() === role)
      .sort((a, b) => b.expected_fantasy_rating - a.expected_fantasy_rating)
      .slice(0, count);

  return [
    ...pick('P', 1),
    ...pick('D', 4),
    ...pick('C', 3),
    ...pick('A', 3)
  ];
}

function getTeam433ProjectedScore(teamData) {
  if (!teamData || !teamData.roster) return 68.5;
  const lineup = getBest433Lineup(teamData.roster);
  const sum = lineup.reduce((acc, p) => acc + p.expected_fantasy_rating, 0);
  return sum + DEFENSE_BONUS;
}

// 4. SIMULAZIONE MONTE CARLO (10.000 ITERAZIONI SU MODULO 4-3-3 + 1.5 BONUS DIFESA)
function simulateTeamGoalsDistribution(teamData, iterations = 10000) {
  const maxGoals = 6;
  const goalCounts = new Array(maxGoals + 1).fill(0);
  const lineup433 = getBest433Lineup(teamData?.roster || []);
  const fallbackMean = getTeam433ProjectedScore(teamData);

  for (let i = 0; i < iterations; i++) {
    let totalScore = DEFENSE_BONUS; // Parte già con +1.5 di Bonus Difesa

    if (lineup433.length === 11) {
      for (const p of lineup433) {
        // Estrazione normale standard (Box-Muller) per la variabilità del voto pagella
        const u1 = Math.random() || 1e-6;
        const u2 = Math.random();
        const z = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);

        // peso titolarità / subentro
        const startProb = (p.starter_probability ?? 80) / 100;
        const playsWeight = startProb + 0.35 * (1 - startProb);

        const baseVote = 6.0 + z * 0.55;
        let bonusMalus = 0;
        const m = p.metrics || {};

        if ((p.role || '').toUpperCase() === 'P') {
          const pCs = (m.clean_sheet_probability ?? 25) / 100;
          if (Math.random() < pCs) {
            bonusMalus += 1.0 + 0.25;
          } else {
            const expConceded = m.expected_goals_conceded ?? 1.35;
            const goalsConceded = Math.max(1, Math.round(expConceded + z * 0.7));
            bonusMalus -= goalsConceded * 1.0 + 0.15;
          }
        } else {
          const pGol = (m.goal_probability ?? 5) / 100;
          const pBrace = (m.brace_probability ?? 1) / 100;
          const pAss = (m.assist_probability ?? 6) / 100;
          const pYel = (m.yellow_card_probability ?? 15) / 100;
          const pRed = (m.red_card_probability ?? 1) / 100;
          const pOwn = (m.own_goal_probability ?? 1) / 100;

          const rollGol = Math.random();
          if (rollGol < pBrace) bonusMalus += 6.0 + 0.7;
          else if (rollGol < pGol) bonusMalus += 3.0 + 0.35;

          if (Math.random() < pAss) bonusMalus += 1.0 + 0.2;
          if (Math.random() < pRed) bonusMalus -= 1.0 + 0.5;
          else if (Math.random() < pYel) bonusMalus -= 0.5 + 0.25;
          if (Math.random() < pOwn) bonusMalus -= 2.0 + 0.4;
        }

        totalScore += baseVote + (bonusMalus * playsWeight);
      }
    } else {
      // Fallback calibrato sulla deviazione standard storica della lega (8.5 pt)
      const u1 = Math.random() || 1e-6;
      const u2 = Math.random();
      const z = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);
      totalScore = fallbackMean + z * 8.5;
    }

    // Conversione FantaPunti -> Gol (Soglia 66 = 1 gol, poi 1 gol ogni 6 punti)
    let goals = 0;
    if (totalScore >= 66) {
      goals = Math.min(maxGoals, Math.floor((totalScore - 60) / 6));
    }
    goalCounts[goals]++;
  }

  return goalCounts.map((count) => count / iterations);
}

// Converte probabilità (0-1) in quota stile SNAI con allibramento del 5%
function probToSnaiOdd(prob) {
  const marginedProb = Math.min(0.92, Math.max(0.03, prob * 1.05));
  return (1 / marginedProb).toFixed(2);
}

// Elaborazione pronostici per ogni partita della giornata
const matchPredictions = (nextRoundObj?.matches || []).map((match) => {
  const homeTeamData = teamXfmMap.get(match.home.toLowerCase().trim());
  const awayTeamData = teamXfmMap.get(match.away.toLowerCase().trim());

  // 1. Definisci le due variabili qui all'inizio del .map() (con la 'u' minuscola)
  const homeLineup = getBest433Lineup(homeTeamData?.roster || []);
  const awayLineup = getBest433Lineup(awayTeamData?.roster || []);

  const homeXfm = getTeam433ProjectedScore(homeTeamData);
  const awayXfm = getTeam433ProjectedScore(awayTeamData);

  const homeGoalProbs = simulateTeamGoalsDistribution(homeTeamData, 10000);
  const awayGoalProbs = simulateTeamGoalsDistribution(awayTeamData, 10000);

  // array per tutti i risultati esatti
  const exactScoresList = [];

  let p1 = 0, pX = 0, p2 = 0, pOver15 = 0, pOver25 = 0, pGoal = 0;
  for (let h = 0; h < homeGoalProbs.length; h++) {
    for (let a = 0; a < awayGoalProbs.length; a++) {
      const jointProb = homeGoalProbs[h] * awayGoalProbs[a];
      if (h > a)
        p1 += jointProb;
      else if (h === a)
        pX += jointProb;
      else
        p2 += jointProb;

      if (h + a > 1.5)
        pOver15 += jointProb;
      if (h + a > 2.5)
        pOver25 += jointProb;
      if (h > 0 && a > 0)
        pGoal += jointProb;

      exactScoresList.push({
        score: `${h}-${a}`,
        prob: jointProb
      });
    }
  }

  const pUnder15 = 1 - pOver15;
  const pUnder25 = 1 - pOver25;
  const pNoGoal = 1 - pGoal;

  // estrae i 3 risultati esatti più probabili e calcola la relativa quota
  const top3Scores = exactScoresList
    .sort((a, b) => b.prob - a.prob)
    .slice(0, 3)
    .map((item) => ({
      score: item.score,
      odd: probToSnaiOdd(item.prob),
      probPercent: Math.round(item.prob * 100)
    }));

  return {
    home: match.home,
    away: match.away,
    homeXfm: homeXfm.toFixed(1),
    awayXfm: awayXfm.toFixed(1),
    homeLineup,
    awayLineup,
    probs: {
      p1: Math.round(p1 * 100),
      pX: Math.round(pX * 100),
      p2: Math.round(p2 * 100)
    },
    topScores: top3Scores,
    odds: {
      one: probToSnaiOdd(p1),
      draw: probToSnaiOdd(pX),
      two: probToSnaiOdd(p2),
      under15: probToSnaiOdd(pUnder15),
      over15: probToSnaiOdd(pOver15),
      under25: probToSnaiOdd(pUnder25),
      over25: probToSnaiOdd(pOver25),
      gg: probToSnaiOdd(pGoal),
      ng: probToSnaiOdd(pNoGoal)
    }
  };
});

// 5. ESTRAZIONE TOP 3 GIOCATORI PER RUOLO (A, C, D, P)
const allPlayers = [];
for (const team of xFMsData) {
  for (const player of team.roster || []) {
    allPlayers.push({
      ...player,
      fantasy_team: team.fantasy_team
    });
  }
}

function getTopByRole(roleCode, limit = 3) {
  return allPlayers
    .filter((p) => (p.role || '').toUpperCase() === roleCode)
    .sort((a, b) => b.expected_fantasy_rating - a.expected_fantasy_rating)
    .slice(0, limit);
}

const topAttackers = getTopByRole('A', 3);
const topMidfielders = getTopByRole('C', 3);
const topDefenders = getTopByRole('D', 3);
const topGoalkeepers = getTopByRole('P', 3);

// Helper per ottenere il percorso del logo in /public/logos/
function getTeamLogo(teamName) {
  if (!teamName) return '/logos/default.png';
  return `/logos/${teamName}.png`;
}

/**
 * Converte la probabilità (0-1) in quota applicando l'allibramento (5%),
 * arrotonda al tick corrispondente per fascia di prezzo e omette gli zeri finali.
 */
function probToSnaiOdd(prob) {
  // Allibramento al 5% con limiti di sicurezza per evitare divisioni per zero
  const marginedProb = Math.min(0.99, Math.max(0.005, prob * 1.05));
  const rawOdd = 1 / marginedProb;

  let step;
  if (rawOdd < 2.0) {
    step = 0.01;
  } else if (rawOdd < 3.0) {
    step = 0.02;
  } else if (rawOdd < 4.0) {
    step = 0.05;
  } else if (rawOdd < 6.0) {
    step = 0.1;
  } else if (rawOdd < 10.0) {
    step = 0.2;
  } else if (rawOdd < 20.0) {
    step = 0.5;
  } else if (rawOdd <= 50.0) {
    step = 1;
  } else {
    step = 5;
  }

  // Arrotonda al multiplo di 'step' più vicino
  const rounded = Math.round(rawOdd / step) * step;

  // Number(rounded.toFixed(2)) pulisce gli errori di virgola mobile di JS (es. 2.4000000000000004)
  // e rimuove automaticamente tutti gli zeri superflui dopo la virgola (es. 2.50 -> 2.5, 4.00 -> 4)
  return String(Number(rounded.toFixed(2)));
}
---

<BaseLayout pageTitle="Pronostici e quote">
  <div class="odds-container">
    
    <!-- BANNER ROSSO DI AVVISO DATI VECCHI (>= 4 GIORNI) -->
    {isDataStale && (
      <div class="stale-banner">
        <div class="stale-icon">⚠️</div>
        <div class="stale-text">
          <strong>ATTENZIONE: DATI OBSOLETI ({daysOld} giorni fa)!</strong>
          <p>Le quote e le probabili formazioni risalgono a più di 4 giorni fa. La preghiamo di contattare l'assistenza per aggiornare i pronostici della giornata.</p>
        </div>
      </div>
    )}

    <div class="header-section">
      <div class="round-badge">
        {nextRoundObj ? `${nextRoundObj.round}ª Giornata Lega • ${nextRoundObj.serie_a_round}ª Serie A` : 'Prossimo Turno'}
      </div>
      <h2 class="main-title">PRONOSTICI DELLA SETTIMANA</h2>
      <p class="subtitle">Quote, probabilità e analisi avanzate per schierare la formazione perfetta</p>
      <p class="update-timestamp">Ultimo aggiornamento dati xFM: <strong>{formattedLastUpdate}</strong></p>
    </div>

    <!-- SEZIONE 1: TABELLONE QUOTE STILE SNAI (MONTE CARLO) -->
    <section class="betting-section">
      <div class="section-header">
        <h3>📊 LAVAGNA QUOTE E PRONOSTICI DI LEGA</h3>
        <span class="model-note">Simulazione Monte Carlo (10.000 match • Modulo 4-3-3 • Gol ogni 6 pt da 66)</span>
      </div>

      <div class="matches-grid">
        {matchPredictions.map((m) => (
          <div class="match-card-wrapper">
            <div class="match-card">
              <!-- 1. SQUADRE UNA ACCANTO ALL'ALTRA -->
              <div class="match-header-versus">
                <div class="team-side home-side">
                  <img src={getTeamLogo(m.home)} alt={m.home} class="team-logo-md" onerror="this.style.display='none'" />
                  <span class="team-name">{m.home}</span>
                </div>
                
                <span class="vs-badge">VS</span>
                
                <div class="team-side away-side">
                  <span class="team-name">{m.away}</span>
                  <img src={getTeamLogo(m.away)} alt={m.away} class="team-logo-md" onerror="this.style.display='none'" />
                </div>
              </div>

              <!-- 2. BARRA A 3 COLORI CON PERCENTUALI DENTRO -->
              <div class="prob-bar-wrapper">
                <div class="prob-bar p1" style={`width: ${m.probs.p1}%`}>
                  {m.probs.p1 >= 10 && <span>{m.probs.p1}%</span>}
                </div>
                <div class="prob-bar pX" style={`width: ${m.probs.pX}%`}>
                  {m.probs.pX >= 10 && <span>{m.probs.pX}%</span>}
                </div>
                <div class="prob-bar p2" style={`width: ${m.probs.p2}%`}>
                  {m.probs.p2 >= 10 && <span>{m.probs.p2}%</span>}
                </div>
              </div>

              <!-- 3. PULSANTI QUOTE 1 - X - 2 -->
              <div class="odds-row main-odds-row">
                <div class="odd-box">
                  <span class="odd-label">1</span>
                  <span class="odd-val">{m.odds.one}</span>
                </div>
                <div class="odd-box">
                  <span class="odd-label">X</span>
                  <span class="odd-val">{m.odds.draw}</span>
                </div>
                <div class="odd-box">
                  <span class="odd-label">2</span>
                  <span class="odd-val">{m.odds.two}</span>
                </div>
              </div>

              <!-- 4. PULSANTI QUOTE SECONDARIE (U/O 1.5, U/O 2.5, GG/NG) -->
              <div class="odds-row secondary-odds-row">
                <div class="odd-box">
                  <span class="odd-label">U 1.5</span>
                  <span class="odd-val">{m.odds.under15}</span>
                </div>
                <div class="odd-box">
                  <span class="odd-label">O 1.5</span>
                  <span class="odd-val">{m.odds.over15}</span>
                </div>
                <div class="odd-box">
                  <span class="odd-label">U 2.5</span>
                  <span class="odd-val">{m.odds.under25}</span>
                </div>
                <div class="odd-box">
                  <span class="odd-label">O 2.5</span>
                  <span class="odd-val">{m.odds.over25}</span>
                </div>
                <div class="odd-box">
                  <span class="odd-label">GG</span>
                  <span class="odd-val">{m.odds.gg}</span>
                </div>
                <div class="odd-box">
                  <span class="odd-label">NG</span>
                  <span class="odd-val">{m.odds.ng}</span>
                </div>

                <!-- 5. TOP 3 RISULTATI ESATTI PIÙ PROBABILI -->
                {m.topScores.map((s) => (
                  <div class="odd-box" title={`Probabilità stimata: ${s.probPercent}%`}>
                    <span class="odd-label">{s.score}</span>
                    <span class="odd-val">{s.odd}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- TENDINA ESPANDIBILE TOP 11 (MODULO 4-3-3) -->
            <details class="lineups-drawer">
              <summary class="drawer-toggle">
                <span>📋 Confronta Top 11 schierati dalla simulazione (Modulo 4-3-3)</span>
                <span class="chevron">▼</span>
              </summary>

              <div class="lineups-comparison">
                <!-- Colonna Squadra Casa -->
                <div class="lineup-col">
                  <div class="lineup-col-header">
                    <img src={getTeamLogo(m.home)} alt={m.home} class="team-logo-xs" onerror="this.style.display='none'" />
                    <strong>{m.home}</strong>
                    <span class="mod-tag">+1.5 Mod. Difesa</span>
                  </div>
                  <ul class="lineup-list">
                    {m.homeLineup.map((p) => (
                      <li class="lineup-item">
                        <span class={`role-pill role-pill-${p.role.toLowerCase()}`}>{p.role}</span>
                        <span class="lineup-player-name">{p.name} <small>({p.real_team})</small></span>
                        <span class="lineup-tit" title="Probabilità titolare">{p.starter_probability}%</span>
                        <span class="lineup-xfm">{p.expected_fantasy_rating.toFixed(2)}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Colonna Squadra Ospite -->
                <div class="lineup-col">
                  <div class="lineup-col-header">
                    <img src={getTeamLogo(m.away)} alt={m.away} class="team-logo-xs" onerror="this.style.display='none'" />
                    <strong>{m.away}</strong>
                    <span class="mod-tag">+1.5 Mod. Difesa</span>
                  </div>
                  <ul class="lineup-list">
                    {m.awayLineup.map((p) => (
                      <li class="lineup-item">
                        <span class={`role-pill role-pill-${p.role.toLowerCase()}`}>{p.role}</span>
                        <span class="lineup-player-name">{p.name} <small>({p.real_team})</small></span>
                        <span class="lineup-tit" title="Probabilità titolare">{p.starter_probability}%</span>
                        <span class="lineup-xfm">{p.expected_fantasy_rating.toFixed(2)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </details>
          </div>
        ))}
      </div>
    </section>

    <!-- SEZIONE 2: TOP 3 GIOCATORI PER RUOLO -->
    <section class="top-players-section">
      <div class="section-header">
        <h3>🔥 I CONSIGLIATI DELLA REDAZIONE (TOP 3 PER RUOLO)</h3>
        <span class="model-note">Ordinati per Expected Fantamedia (xFM) di giornata</span>
      </div>

      <div class="roles-grid">
        <!-- ATTACCANTI -->
        <div class="role-column">
          <div class="role-banner role-a">⚡ TOP 3 ATTACCANTI</div>
          {topAttackers.map((p, idx) => (
            <div class="player-card">
              <div class="rank-number">#{idx + 1}</div>
              <img src={getTeamLogo(p.fantasy_team)} alt={p.fantasy_team} class="fanta-logo" onerror="this.style.display='none'" />
              <div class="player-info">
                <div class="player-name">{p.name} <span class="serie-a-team">({p.real_team})</span></div>
                <div class="fanta-owner">{p.fantasy_team}</div>
                <div class="player-badges">
                  <span class="badge badge-gol">⚽ Gol: {p.metrics?.goal_probability ?? 0}%</span>
                  <span class="badge badge-assist">👟 Assist: {p.metrics?.assist_probability ?? 0}%</span>
                  <span class="badge badge-tit">👕 Tit: {p.starter_probability}%</span>
                </div>
              </div>
              <div class="xfm-score">
                <span class="xfm-number">{p.expected_fantasy_rating.toFixed(2)}</span>
                <span class="xfm-label">xFM</span>
              </div>
            </div>
          ))}
        </div>

        <!-- CENTROCAMPISTI -->
        <div class="role-column">
          <div class="role-banner role-c">🎯 TOP 3 CENTROCAMPISTI</div>
          {topMidfielders.map((p, idx) => (
            <div class="player-card">
              <div class="rank-number">#{idx + 1}</div>
              <img src={getTeamLogo(p.fantasy_team)} alt={p.fantasy_team} class="fanta-logo" onerror="this.style.display='none'" />
              <div class="player-info">
                <div class="player-name">{p.name} <span class="serie-a-team">({p.real_team})</span></div>
                <div class="fanta-owner">{p.fantasy_team}</div>
                <div class="player-badges">
                  <span class="badge badge-gol">⚽ Gol: {p.metrics?.goal_probability ?? 0}%</span>
                  <span class="badge badge-assist">👟 Assist: {p.metrics?.assist_probability ?? 0}%</span>
                  <span class="badge badge-tit">👕 Tit: {p.starter_probability}%</span>
                </div>
              </div>
              <div class="xfm-score">
                <span class="xfm-number">{p.expected_fantasy_rating.toFixed(2)}</span>
                <span class="xfm-label">xFM</span>
              </div>
            </div>
          ))}
        </div>

        <!-- DIFENSORI -->
        <div class="role-column">
          <div class="role-banner role-d">🛡️ TOP 3 DIFENSORI</div>
          {topDefenders.map((p, idx) => (
            <div class="player-card">
              <div class="rank-number">#{idx + 1}</div>
              <img src={getTeamLogo(p.fantasy_team)} alt={p.fantasy_team} class="fanta-logo" onerror="this.style.display='none'" />
              <div class="player-info">
                <div class="player-name">{p.name} <span class="serie-a-team">({p.real_team})</span></div>
                <div class="fanta-owner">{p.fantasy_team}</div>
                <div class="player-badges">
                  <span class="badge badge-assist">👟 Assist: {p.metrics?.assist_probability ?? 0}%</span>
                  <span class="badge badge-gol">⚽ Gol: {p.metrics?.goal_probability ?? 0}%</span>
                  <span class="badge badge-warn">🟨 Giallo: {p.metrics?.yellow_card_probability ?? 0}%</span>
                </div>
              </div>
              <div class="xfm-score">
                <span class="xfm-number">{p.expected_fantasy_rating.toFixed(2)}</span>
                <span class="xfm-label">xFM</span>
              </div>
            </div>
          ))}
        </div>

        <!-- PORTIERI -->
        <div class="role-column">
          <div class="role-banner role-p">🧤 TOP 3 PORTIERI</div>
          {topGoalkeepers.map((p, idx) => (
            <div class="player-card">
              <div class="rank-number">#{idx + 1}</div>
              <img src={getTeamLogo(p.fantasy_team)} alt={p.fantasy_team} class="fanta-logo" onerror="this.style.display='none'" />
              <div class="player-info">
                <div class="player-name">{p.name} <span class="serie-a-team">({p.real_team})</span></div>
                <div class="fanta-owner">{p.fantasy_team}</div>
                <div class="player-badges">
                  <span class="badge badge-cs">🔒 Imbattibilità: {p.metrics?.clean_sheet_probability ?? 0}%</span>
                  <span class="badge badge-warn">🥅 Gol Subiti Att.: {p.metrics?.expected_goals_conceded ?? '-'}</span>
                </div>
              </div>
              <div class="xfm-score">
                <span class="xfm-number">{p.expected_fantasy_rating.toFixed(2)}</span>
                <span class="xfm-label">xFM</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .odds-container {
    max-width: 1050px;
    margin: 0 auto;
    padding: 20px 15px;
    font-family: 'Helvetica', 'Arial', sans-serif;
  }

  /* BANNER ROSSO DATI VECCHI */
