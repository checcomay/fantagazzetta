  /* GRIGLIE PULSANTI QUOTE */
  .odds-row { display: grid; gap: 10px; width: 100%; }
  .main-odds-row { grid-template-columns: repeat(3, 1fr); padding-top: 4px; }
  .dc-odds-row { grid-template-columns: repeat(3, 1fr); margin-top: 2px; }
  .secondary-odds-row { grid-template-columns: repeat(6, 1fr); }

  .odd-box {
    display: flex;
