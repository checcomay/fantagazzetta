import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import calendarData from '../data/calendar.json';
import xFMsData from '../data/xFMs.json';

// 1. CONTROLLO DATA DI ULTIMA MODIFICA DI xFMs.json
const xfmFilePath = path.resolve(process.cwd(), 'src/data/xFMs.json');
let lastModifiedDate = new Date();
let isDataStale = false;
let daysOld = 0;

try {
  const stats = fs.statSync(xfmFilePath);
  lastModifiedDate = stats.mtime;
  const diffMs = Date.now() - lastModifiedDate.getTime();
  daysOld = Math.floor(diffMs / (1000 * 60 * 60 * 24));
  isDataStale = daysOld >= 3;
} catch (e) {
  isDataStale = true;
}

const formattedLastUpdate = lastModifiedDate.toLocaleDateString('it-IT', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
});

// 2. INDIVIDUAZIONE PRIMA GIORNATA NON ANCORA GIOCATA
const nextRoundObj = calendarData.rounds?.find((r) =>
  r.matches.some((m) => !m.played)
) || calendarData.rounds?.[0];

// Mappa rapida: nome squadra -> dati xFM
const teamXfmMap = new Map();
for (const team of xFMsData) {
  teamXfmMap.set(team.fantasy_team.toLowerCase().trim(), team);
}

// 3. ESTRAZIONE FORMAZIONE E PUNTEGGIO OTTIMIZZATO (Basato sul modulo scelto in xFMs.json)
function getTeamProjectedScore(teamData) {
  if (!teamData || !teamData.roster) return 68.5;
  // Restituisce direttamente il punteggio top 11 calcolato dall'ottimizzatore moduli
  return teamData.projected_top11_score ?? 68.5;
}

function getTeamStartingLineup(teamData) {
  if (!teamData || !teamData.roster) return [];
  const startingNames = new Set(teamData.starting_eleven || []);
  const lineup = teamData.roster.filter((p) => startingNames.has(p.name));

  // Ordinamento rigoroso per ruolo: P -> D -> C -> A
  const roleOrder = { P: 1, D: 2, C: 3, A: 4 };
  return lineup.sort((a, b) => {
    const rA = roleOrder[(a.role || '').toUpperCase()] || 5;
    const rB = roleOrder[(b.role || '').toUpperCase()] || 5;
    if (rA !== rB) return rA - rB;
    return b.expected_fantasy_rating - a.expected_fantasy_rating;
  });
}

// 4. SIMULAZIONE MONTE CARLO (10.000 ITERAZIONI SUL MODULO OTTIMIZZATO DELLA SQUADRA)
function simulateTeamGoalsDistribution(teamData, iterations = 10000) {
  const maxGoals = 6;
  const goalCounts = new Array(maxGoals + 1).fill(0);
  const lineup = getTeamStartingLineup(teamData);
  const fallbackMean = getTeamProjectedScore(teamData);
  const defenseBonus = teamData?.defense_modifier_bonus ?? 1.5;

  for (let i = 0; i < iterations; i++) {
    let totalScore = defenseBonus; 

    if (lineup.length === 11) {
      for (const p of lineup) {
        const u1 = Math.random() || 1e-6;
        const u2 = Math.random();
        const z = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);

        const startProb = (p.starter_probability ?? 80) / 100;
        const baseVote = 6.0 + z * 0.55;
        let bonusMalus = 0;
        const m = p.metrics || {};

        if ((p.role || '').toUpperCase() === 'P') {
          const pCs = (m.clean_sheet_probability ?? 25) / 100;
          if (Math.random() < pCs) {
            bonusMalus += 1.0 + 0.25;
          } else {
            const expConceded = m.expected_goals_conceded ?? 1.35;
            const goalsConceded = Math.max(1, Math.round(expConceded + z * 0.7));
            bonusMalus -= goalsConceded * 1.0 + 0.15;
          }
        } else {
          const pGol = (m.goal_probability ?? 5) / 100;
          const pBrace = (m.brace_probability ?? 1) / 100;
          const pAss = (m.assist_probability ?? 6) / 100;
          const pYel = (m.yellow_card_probability ?? 15) / 100;
          const pRed = (m.red_card_probability ?? 1) / 100;
          const pOwn = (m.own_goal_probability ?? 1) / 100;

          const rollGol = Math.random();
          if (rollGol < pBrace) bonusMalus += 6.0 + 0.7;
          else if (rollGol < pGol) bonusMalus += 3.0 + 0.35;

          if (Math.random() < pAss) bonusMalus += 1.0 + 0.2;
          if (Math.random() < pRed) bonusMalus -= 1.0 + 0.5;
          else if (Math.random() < pYel) bonusMalus -= 0.5 + 0.25;
          if (Math.random() < pOwn) bonusMalus -= 2.0 + 0.4;
        }

        const playsWeight = startProb + 0.35 * (1 - startProb);
        totalScore += baseVote + (bonusMalus * playsWeight);
      }
    } else {
      const u1 = Math.random() || 1e-6;
      const u2 = Math.random();
      const z = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);
      totalScore = fallbackMean + z * 8.5;
    }

    let goals = 0;
    if (totalScore >= 66) {
      goals = Math.min(maxGoals, Math.floor((totalScore - 60) / 6));
    }
    goalCounts[goals]++;
  }

  return goalCounts.map((count) => count / iterations);
}

// Helper quote SNAI
function probToSnaiOdd(prob) {
  const marginedProb = Math.min(0.99, Math.max(0.005, prob * 1.05));
  const rawOdd = 1 / marginedProb;

  let step;
  if (rawOdd < 2.0) step = 0.01;
  else if (rawOdd < 3.0) step = 0.02;
  else if (rawOdd < 4.0) step = 0.05;
  else if (rawOdd < 6.0) step = 0.1;
  else if (rawOdd < 10.0) step = 0.2;
  else if (rawOdd < 20.0) step = 0.5;
  else if (rawOdd <= 50.0) step = 1;
  else step = 5;

  const rounded = Math.round(rawOdd / step) * step;
  return String(Number(rounded.toFixed(2)));
}

// Elaborazione pronostici per ogni partita della giornata
const matchPredictions = (nextRoundObj?.matches || []).map((match) => {
  const homeTeamData = teamXfmMap.get(match.home.toLowerCase().trim());
  const awayTeamData = teamXfmMap.get(match.away.toLowerCase().trim());

  const homeLineup = getTeamStartingLineup(homeTeamData);
  const awayLineup = getTeamStartingLineup(awayTeamData);

  const homeXfm = getTeamProjectedScore(homeTeamData);
  const awayXfm = getTeamProjectedScore(awayTeamData);

  // Modulo ottimale scelto per le due squadre
  const homeFormation = homeTeamData?.formation || '4-3-3';
  const awayFormation = awayTeamData?.formation || '4-3-3';

  const homeGoalProbs = simulateTeamGoalsDistribution(homeTeamData, 10000);
  const awayGoalProbs = simulateTeamGoalsDistribution(awayTeamData, 10000);

  const exactScoresList = [];
  let p1 = 0, pX = 0, p2 = 0, pOver15 = 0, pOver25 = 0, 
      pOver35 = 0, pOver45 = 0, pOver55 = 0;
  let pGoal = 0;

  for (let h = 0; h < homeGoalProbs.length; h++) {
    for (let a = 0; a < awayGoalProbs.length; a++) {
      const jointProb = homeGoalProbs[h] * awayGoalProbs[a];

      if (h > a) p1 += jointProb;
      else if (h === a) pX += jointProb;
      else p2 += jointProb;

      if (h + a > 1.5) pOver15 += jointProb;
      if (h + a > 2.5) pOver25 += jointProb;
      if (h + a > 3.5) pOver35 += jointProb;
      if (h + a > 4.5) pOver45 += jointProb;
      if (h + a > 5.5) pOver55 += jointProb;

      if (h > 0 && a > 0) pGoal += jointProb;

      exactScoresList.push({
        score: `${h}-${a}`,
        prob: jointProb
      });
    }
  }

  const pUnder15 = 1 - pOver15;
  const pUnder25 = 1 - pOver25;
  const pUnder35 = 1 - pOver35;
  const pUnder45 = 1 - pOver45;
  const pUnder55 = 1 - pOver55;
  const pNoGoal = 1 - pGoal;

  const p1X = p1 + pX;
  const pX2 = pX + p2;
  const p12 = p1 + p2;

  const top3Scores = exactScoresList
    .sort((a, b) => b.prob - a.prob)
    .slice(0, 6)
    .map((item) => ({
      score: item.score,
      odd: probToSnaiOdd(item.prob),
      probPercent: Math.round(item.prob * 100)
    }));

  return {
    home: match.home,
    away: match.away,
    homeXfm: homeXfm.toFixed(1),
    awayXfm: awayXfm.toFixed(1),
    homeFormation,
    awayFormation,
    homeLineup,
    awayLineup,
    probs: {
      p1: Math.round(p1 * 100),
      pX: Math.round(pX * 100),
      p2: Math.round(p2 * 100)
    },
    topScores: top3Scores,
    odds: {
      one: probToSnaiOdd(p1),
      draw: probToSnaiOdd(pX),
      two: probToSnaiOdd(p2),
      oneX: probToSnaiOdd(p1X),
      xTwo: probToSnaiOdd(pX2),
      oneTwo: probToSnaiOdd(p12),
      under15: probToSnaiOdd(pUnder15),
      over15: probToSnaiOdd(pOver15),
      under25: probToSnaiOdd(pUnder25),
      over25: probToSnaiOdd(pOver25),
      under35: probToSnaiOdd(pUnder35),
      over35: probToSnaiOdd(pOver35),
      under45: probToSnaiOdd(pUnder45),
      over45: probToSnaiOdd(pOver45),
      under55: probToSnaiOdd(pUnder55),
      over55: probToSnaiOdd(pOver55),
      gg: probToSnaiOdd(pGoal),
      ng: probToSnaiOdd(pNoGoal)
    }
  };
});

// Helper logo
function getTeamLogo(teamName) {
  if (!teamName) return '/logos/default.png';
  return `/logos/${teamName}.png`;
}

// 5. ESTRAZIONE TOP 3 GIOCATORI PER RUOLO (A, C, D, P)
const allPlayers = [];
for (const team of xFMsData) {
  for (const player of team.roster || []) {
    allPlayers.push({
      ...player,
      fantasy_team: team.fantasy_team
    });
  }
}

function getTopByRole(roleCode, limit = 3) {
  return allPlayers
    .filter((p) => {
      const role = (p.role || '').toUpperCase();
      if (role !== roleCode) return false;
      
      // I portieri con 0% di probabilità di titolarità non devono MAI comparire nei consigliati
      if (role === 'P' && (p.starter_probability ?? 0) <= 0) {
        return false;
      }
      
      // Per gli altri ruoli pretendiamo comunque che abbiano almeno un minimo di probabilità (> 0)
      return (p.starter_probability ?? 0) > 0;
    })
    .sort((a, b) => b.expected_fantasy_rating - a.expected_fantasy_rating)
    .slice(0, limit);
}

const topAttackers = getTopByRole('A', 3);
const topMidfielders = getTopByRole('C', 3);
const topDefenders = getTopByRole('D', 3);
const topGoalkeepers = getTopByRole('P', 3);

// Helper per ottenere il percorso del logo in /public/logos/
function getTeamLogo(teamName) {
  if (!teamName) return '/logos/default.png';
  return `/logos/${teamName}.png`;
}

/**
 * Converte la probabilità (0-1) in quota applicando l'allibramento (5%),
 * arrotonda al tick corrispondente per fascia di prezzo e omette gli zeri finali.
 */
function probToSnaiOdd(prob) {
  // Allibramento al 5% con limiti di sicurezza per evitare divisioni per zero
  const marginedProb = Math.min(0.99, Math.max(0.005, prob * 1.05));
  const rawOdd = 1 / marginedProb;

  let step;
  if (rawOdd < 2.0) {
    step = 0.01;
  } else if (rawOdd < 3.0) {
    step = 0.02;
  } else if (rawOdd < 4.0) {
    step = 0.05;
  } else if (rawOdd < 6.0) {
    step = 0.1;
  } else if (rawOdd < 10.0) {
    step = 0.2;
  } else if (rawOdd < 20.0) {
    step = 0.5;
  } else if (rawOdd <= 50.0) {
    step = 1;
  } else {
    step = 5;
  }

  // Arrotonda al multiplo di 'step' più vicino
  const rounded = Math.round(rawOdd / step) * step;

  // Number(rounded.toFixed(2)) pulisce gli errori di virgola mobile di JS (es. 2.4000000000000004)
  // e rimuove automaticamente tutti gli zeri superflui dopo la virgola (es. 2.50 -> 2.5, 4.00 -> 4)
  return String(Number(rounded.toFixed(2)));
}
---

<BaseLayout pageTitle="Pronostici e quote">
  <div class="odds-container">
    
    <!-- BANNER ROSSO DI AVVISO DATI VECCHI (>= 4 GIORNI) -->
    {isDataStale && (
      <div class="stale-banner">
        <div class="stale-icon">⚠️</div>
        <div class="stale-text">
          <strong>ATTENZIONE: DATI OBSOLETI!</strong>
          <p>Le quote e le probabili formazioni risalgono a più di {daysOld} giorni fa. La preghiamo di contattare l'assistenza per aggiornare i pronostici della giornata.</p>
        </div>
      </div>
    )}

    <div class="header-section">
      <div class="round-badge">
        {nextRoundObj ? `${nextRoundObj.round}ª Giornata Lega • ${nextRoundObj.serie_a_round}ª Serie A` : 'Prossimo Turno'}
      </div>
      <h2 class="main-title">PRONOSTICI DELLA SETTIMANA</h2>
      <p class="subtitle">Quote, probabilità e analisi avanzate per schierare la formazione perfetta</p>
      <p class="update-timestamp">Ultimo aggiornamento dati xFM: <strong>{formattedLastUpdate}</strong></p>
    </div>

    <!-- WIDGET SCHEDINA A TENDINA (STICKY) -->
    <div class="bet-slip-wrapper" id="bet-slip-wrapper">
      <button type="button" class="slip-toggle-btn" id="slip-toggle">
        <div class="slip-toggle-info">
          <span class="slip-icon">🎟️</span>
          <strong>LA TUA SCHEDINA:</strong>
          <span id="slip-count-badge">0 giocate</span>
        </div>
        <div class="slip-toggle-right">
          <span class="user-credits-badge" id="header-user-credits">💰 Crediti: 100</span>
          <span class="total-multiplier-badge" id="slip-header-odd">Quota: 1.00</span>
          <span class="arrow-indicator" id="slip-arrow">▼</span>
        </div>
      </button>

      <!-- Menu a tendina espandibile -->
      <div class="slip-dropdown-content" id="slip-dropdown" style="display: none;">
        <div id="slip-items-list" class="slip-items-list">
          <p class="empty-slip-text">Nessun pronostico selezionato. Clicca sulle quote della giornata per iniziare!</p>
        </div>

        <div class="slip-summary" id="slip-summary" style="display: none;">
          <div class="summary-row">
            <span>Moltiplicatore Totale:</span>
            <strong id="summary-multiplier" class="highlight-odd">1.00</strong>
          </div>

          <div class="bet-stake-row">
            <label for="bet-stake">Puntata in Crediti:</label>
            <input type="number" id="bet-stake" value="10" min="1" max="500" />
          </div>

          <div class="summary-row">
            <span>Potenziale vincita:</span>
            <strong id="summary-win" class="highlight-win">10.00 crediti</strong>
          </div>

          <div class="user-email-section">
            <label for="bettor-email">Inserisci la tua email per giocare e scalare i crediti:</label>
            <input type="email" id="bettor-email" placeholder="nome@esempio.it" required />
          </div>

          <button type="button" class="submit-bet-btn" id="submit-bet-btn">
            REGISTRA SCHEDINA
          </button>
          <div id="bet-feedback" class="bet-feedback"></div>
        </div>
      </div>
    </div>

    <!-- SEZIONE 1: TABELLONE QUOTE STILE SNAI (MONTE CARLO) -->
    <section class="betting-section">
      <div class="section-header">
        <h3>📊 LAVAGNA QUOTE E PRONOSTICI DI LEGA</h3>
          <span class="model-note">Simulazione Monte Carlo (10.000 match • Moduli ottimizzati • Gol ogni 6 pt da 66)</span>
      </div>

      <div class="matches-grid">
        {matchPredictions.map((m) => (
          <div class="match-card-wrapper">
            <div class="match-card">
              <!-- 1. SQUADRE UNA ACCANTO ALL'ALTRA -->
              <div class="match-header-versus">
                <div class="team-side home-side">
                  <img src={getTeamLogo(m.home)} alt={m.home} class="team-logo-md" onerror="this.style.display='none'" />
                  <span class="team-name">{m.home}</span>
                </div>
                
                <span class="vs-badge">VS</span>
                
                <div class="team-side away-side">
                  <span class="team-name">{m.away}</span>
                  <img src={getTeamLogo(m.away)} alt={m.away} class="team-logo-md" onerror="this.style.display='none'" />
                </div>
              </div>

              <!-- 2. BARRA A 3 COLORI CON PERCENTUALI DENTRO -->
              <div class="prob-bar-wrapper">
                <div class="prob-bar p1" style={`width: ${m.probs.p1}%`}>
                  {m.probs.p1 >= 10 && <span>{m.probs.p1}%</span>}
                </div>
                <div class="prob-bar pX" style={`width: ${m.probs.pX}%`}>
                  {m.probs.pX >= 10 && <span>{m.probs.pX}%</span>}
                </div>
                <div class="prob-bar p2" style={`width: ${m.probs.p2}%`}>
                  {m.probs.p2 >= 10 && <span>{m.probs.p2}%</span>}
                </div>
              </div>

              <!-- 3. PULSANTI QUOTE 1 - X - 2 -->
              <div class="odds-row main-odds-row">
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-pick="1" data-odd={m.odds.one}>
                  <span class="odd-label">1</span>
                  <span class="odd-val">{m.odds.one}</span>
                </div>
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-pick="X" data-odd={m.odds.draw}>
                  <span class="odd-label">X</span>
                  <span class="odd-val">{m.odds.draw}</span>
                </div>
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-pick="2" data-odd={m.odds.two}>
                  <span class="odd-label">2</span>
                  <span class="odd-val">{m.odds.two}</span>
                </div>
              </div>

              <!-- 3b. PULSANTI DOPPIA CHANCE (1X - X2 - 12) -->
              <div class="odds-row dc-odds-row">
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="esito" data-pick="1X" data-odd={m.odds.oneX}>
                  <span class="odd-label">1X</span>
                  <span class="odd-val">{m.odds.oneX}</span>
                </div>
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="esito" data-pick="X2" data-odd={m.odds.xTwo}>
                  <span class="odd-label">X2</span>
                  <span class="odd-val">{m.odds.xTwo}</span>
                </div>
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="esito" data-pick="12" data-odd={m.odds.oneTwo}>
                  <span class="odd-label">12</span>
                  <span class="odd-val">{m.odds.oneTwo}</span>
                </div>
              </div>

              <!-- 4. PULSANTI QUOTE SECONDARIE (U/O 1.5, 2.5, 3.5, 4.5, 5.5, GG/NG, 6 RISULTATI ESATTI) -->
              <div class="odds-row secondary-odds-row">
                <!-- U/O 1.5 -->
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="uo15" data-pick="U 1.5" data-odd={m.odds.under15}>
                  <span class="odd-label">U 1.5</span>
                  <span class="odd-val">{m.odds.under15}</span>
                </div>
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="uo15" data-pick="O 1.5" data-odd={m.odds.over15}>
                  <span class="odd-label">O 1.5</span>
                  <span class="odd-val">{m.odds.over15}</span>
                </div>

                <!-- U/O 2.5 -->
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="uo25" data-pick="U 2.5" data-odd={m.odds.under25}>
                  <span class="odd-label">U 2.5</span>
                  <span class="odd-val">{m.odds.under25}</span>
                </div>
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="uo25" data-pick="O 2.5" data-odd={m.odds.over25}>
                  <span class="odd-label">O 2.5</span>
                  <span class="odd-val">{m.odds.over25}</span>
                </div>

                <!-- U/O 3.5 -->
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="uo35" data-pick="U 3.5" data-odd={m.odds.under35}>
                  <span class="odd-label">U 3.5</span>
                  <span class="odd-val">{m.odds.under35}</span>
                </div>
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="uo35" data-pick="O 3.5" data-odd={m.odds.over35}>
                  <span class="odd-label">O 3.5</span>
                  <span class="odd-val">{m.odds.over35}</span>
                </div>

                <!-- U/O 4.5 -->
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="uo45" data-pick="U 4.5" data-odd={m.odds.under45}>
                  <span class="odd-label">U 4.5</span>
                  <span class="odd-val">{m.odds.under45}</span>
                </div>
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="uo45" data-pick="O 4.5" data-odd={m.odds.over45}>
                  <span class="odd-label">O 4.5</span>
                  <span class="odd-val">{m.odds.over45}</span>
                </div>

                <!-- U/O 5.5 -->
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="uo55" data-pick="U 5.5" data-odd={m.odds.under55}>
                  <span class="odd-label">U 5.5</span>
                  <span class="odd-val">{m.odds.under55}</span>
                </div>
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="uo55" data-pick="O 5.5" data-odd={m.odds.over55}>
                  <span class="odd-label">O 5.5</span>
                  <span class="odd-val">{m.odds.over55}</span>
                </div>

                <!-- GOL / NO GOL -->
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="gol" data-pick="GG" data-odd={m.odds.gg}>
                  <span class="odd-label">GG</span>
                  <span class="odd-val">{m.odds.gg}</span>
                </div>
                <div class="odd-box bet-pick" data-match={`${m.home} - ${m.away}`} data-market="gol" data-pick="NG" data-odd={m.odds.ng}>
                  <span class="odd-label">NG</span>
                  <span class="odd-val">{m.odds.ng}</span>
                </div>

                <!-- TOP 6 RISULTATI ESATTI -->
                {m.topScores.map((s) => (
