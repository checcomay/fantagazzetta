---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articleEntries = await getCollection('articles');
  return articleEntries.map(entry => ({
    params: { slug: entry.id }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout pageTitle={entry.data.title}>

  <!-- PULSANTE TORNA ALLA HOME -->
  <div class="back-nav">
    <a href="/" class="back-btn">← Torna alla homepage</a>
  </div>

  <div class="article-header">
    <span class="matchday-tag">{entry.data.matchday}</span>
    <!-- Titolo ingrandito -->
    <h2 class="main-title">{entry.data.title}</h2>
    <!-- Sottotitolo ingrandito -->
    <h3 class="main-subtitle">{entry.data.subtitle}</h3>
    
    <div class="meta-data">
      <span>Data di pubblicazione: {entry.data.publishDate.toLocaleDateString('it-IT')}</span>
    </div>
  </div>

  <div class="article-content">
    <Content />

    <!-- BOX AUTORE -->
    {entry.data.author && entry.data.author.trim() !== "" && (
      <div class="author-box">
        <span class="author-badge">Autore</span>
        <div class="author-info">
          <div class="author-icon">
            <!-- Usa favicon.png, con fallback a favicon.svg in caso di errore -->
            <img src="/favicon.png" alt="Icona Autore" onerror="this.src='/favicon.svg'" />
          </div>
          <span class="author-name">{entry.data.author}</span>
        </div>
      </div>
    )}
  </div>

    <!-- NUOVA SEZIONE VOTI REDAZIONE (Condizionale) -->
  { (entry.data.bestPlayer || entry.data.worstPlayer) && (
    <div class="match-ratings-container">
      <h4 class="ratings-title">I Voti della Redazione</h4>
      
      <div class="ratings-grid">
        {entry.data.bestPlayer && (
          <div class="rating-card top-player">
            <div class="emoji-icon">🏅</div>
            <div class="rating-details">
              <span class="rating-label">Migliore in campo</span>
              <span class="player-name">{entry.data.bestPlayer}</span>
            </div>
          </div>
        )}

        {entry.data.worstPlayer && (
          <div class="rating-card worst-player">
            <div class="emoji-icon">💩</div>
            <div class="rating-details">
              <span class="rating-label">Peggiore in campo</span>
              <span class="player-name">{entry.data.worstPlayer}</span>
            </div>
          </div>
        )}
      </div>
    </div>
  )}

</BaseLayout>

<style is:global>
  /* Pulsante Torna alla Home */
  .back-nav {
    margin-bottom: 25px;
  }
  .back-btn {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-weight: bold;
    color: #c0392b;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.85rem;
    display: inline-block;
    padding: 8px 14px;
    border: 2px solid #c0392b;
    border-radius: 4px;
    transition: background 0.3s, color 0.3s;
  }
  .back-btn:hover {
    background-color: #c0392b;
    color: #fff;
  }

  /* Intestazione Articolo */
  .article-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid #ccc;
  }
  .matchday-tag {
    font-family: 'Helvetica', 'Arial', sans-serif;
    color: #c0392b;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    display: block;
    margin-bottom: 10px;
  }
  .main-title {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 2.4rem;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 15px 0;
    line-height: 1.1;
  }
  .main-subtitle {
    font-family: 'Georgia', serif;
    font-size: 1.2rem;
    color: #444;
    font-weight: normal;
    line-height: 1.4;
    margin: 0 0 15px 0;
  }
  .meta-data {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 0.9rem;
    color: #777;
  }

  /* Contenuto articolo */
  .article-content {
    line-height: 1.7;
    font-size: 1.2rem;
    color: #222;
  }
  .article-content p {
    margin-bottom: 20px;
  }
  
  .article-content img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 35px auto;
    border-radius: 4px;
  }

  /* Stile Voti Redazione */
  .match-ratings-container {
    margin-top: 50px;
    padding-top: 30px;
    border-top: 3px solid #111;
  }
  .ratings-title {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 1.8rem;
    font-weight: 900;
    text-transform: uppercase;
    text-align: center;
    margin-bottom: 30px;
    margin-top: 0;
  }
  
  .ratings-grid {
    display: flex;
    gap: 20px;
    justify-content: space-between;
  }

  .rating-card {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 20px;
    border-radius: 8px;
    border-left: 6px solid #ccc; /* Bordo laterale come accento */
  }

  .top-player {
    background-color: #f0fdf4; /* Sfondo verdino */
    border-left-color: #22c55e; /* Bordo verde */
  }

  .worst-player {
    background-color: #fef2f2; /* Sfondo rossastro */
    border-left-color: #ef4444; /* Bordo rosso */
  }

  .emoji-icon {
    font-size: 3rem;
    margin-right: 20px;
  }

  .rating-details {
    display: flex;
    flex-direction: column;
  }

  .rating-label {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 0.85rem;
    font-weight: bold;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 5px;
  }

  .player-name {
    font-family: 'Georgia', serif;
    font-size: 1.3rem;
    font-weight: bold;
    color: #111;
  }

  /* STILE PER LE DIDASCALIE DELLE IMMAGINI */
  .article-content p:has(img) em {
    display: block;            /* Manda il testo a capo sotto l'immagine */
    text-align: center;        /* Centra il testo */
    font-size: 0.95rem;        /* Lo rende un po' più piccolo del testo normale */
    color: #666;               /* Colore grigio scuro, stile giornale */
    margin-top: -20px;         /* Avvicina la scritta all'immagine riducendo lo spazio */
    margin-bottom: 30px;       /* Dà respiro prima del paragrafo successivo */
    font-style: italic;
  }

  /* STILI PER I SOTTOTITOLI NEL TESTO (## e ### nel Markdown) */
  .article-content h2 {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 1.6rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #111;
    margin-top: 45px;
    margin-bottom: 15px;
    border-bottom: 2px solid #eaeaea; /* Sottile linea di separazione */
    padding-bottom: 5px;
  }

  .article-content h3 {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
    color: #c0392b; /* Rosso acceso per far risaltare i paragrafi */
    text-transform: uppercase;
    margin-top: 40px;
    margin-bottom: 15px;
  }
  
  .article-content h4 {
    font-family: 'Georgia', serif;
    font-size: 1.2rem;
    font-weight: bold;
    font-style: italic;
    color: #333;
    margin-top: 30px;
    margin-bottom: 10px;
  }

  /* ========================================= */
  /* STILI BOX AUTORE                          */
  /* ========================================= */
  .author-box {
    position: relative;
    background-color: #f0f2f5; /* Grigio chiaro dello sfondo */
    border-radius: 12px;
    padding: 20px 25px;
    margin-top: 60px; /* Distanzia il box dalla fine del testo */
    margin-bottom: 30px;
  }
  
  .author-badge {
    position: absolute;
    top: -12px; /* Fa sbordare il badge verso l'alto */
    left: 20px;
    background-color: #1a73e8; /* Blu accesso */
    color: #fff;
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: 12px;
  }
  
  .author-info {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 5px;
  }
  
  .author-icon {
    width: 45px;
    height: 45px;
    background-color: #fff;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.08); /* Leggera ombra per staccarlo dal grigio */
    overflow: hidden;
  }
  
  .author-icon img {
    width: 25px;
    height: 25px;
    object-fit: contain;
  }
  
  .author-name {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 1.1rem;
    font-weight: bold;
    color: #111;
  }

  /* Adattamento articolo per dispositivi mobili */
  @media (max-width: 600px) {

    .article-content {
      font-size: 1.05rem;
      line-height: 1.5;
    }
    
    .article-content p:has(img) em {
      font-size: 0.85rem;
      margin-bottom: 20px; 
    }

    .article-content h2 {
      font-size: 1.4rem;
    }
    .article-content h3 {
      font-size: 1.15rem; 
    }

    .ratings-grid {
      flex-direction: column;
    }
    .main-title {
      font-size: 2.2rem;
    }
    .main-subtitle {
      font-size: 1.2rem;
    }
  }
</style>
