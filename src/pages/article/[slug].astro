---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 1. Legge lo slug direttamente dall'URL in modalità Server
const { slug } = Astro.params;

// 2. Recupera l'articolo specifico dal database/collection
const entry = await getEntry('articles', slug);

// 3. Controllo di sicurezza se l'articolo non esiste
if (!entry) {
  return new Response('Articolo non trovato', { status: 404 });
}

const { Content } = await render(entry);
---

<BaseLayout pageTitle={entry.data.title}>

  <!-- PULSANTE TORNA ALLA HOME -->
  <div class="back-nav">
    <a href="/" class="back-btn">← Torna alla homepage</a>
  </div>

  <div class="article-header">
    <span class="matchday-tag">{entry.data.matchday}</span>
    <!-- Titolo -->
    <h2 class="main-title">{entry.data.title}</h2>
    <!-- Sottotitolo -->
    <h3 class="main-subtitle">{entry.data.subtitle}</h3>
    
    <div class="meta-data">
      <span>Data di pubblicazione: {entry.data.publishDate.toLocaleDateString('it-IT')}</span>
    </div>
  </div>

  <div class="article-content">
    <Content />
  </div>

  <!-- I VOTI DELLA REDAZIONE -->
  {(entry.data.bestPlayer || entry.data.worstPlayer || entry.data.bestGoal) && (
    <div class="match-ratings-container">
      <h3 class="ratings-title">I voti della redazione</h3>
      
      <div class="ratings-grid">
        <!-- SEZIONE MIGLIORE IN CAMPO -->
        {entry.data.bestPlayer && (
          <div class="rating-card top-player">
            <span class="emoji-icon">🏅</span>
            <div class="rating-details">
              <span class="rating-label">Migliore in campo</span>
              <strong class="player-name">{entry.data.bestPlayer}</strong>
            </div>
          </div>
        )}

        <!-- SEZIONE PEGGIORE IN CAMPO -->
        {entry.data.worstPlayer && (
          <div class="rating-card worst-player">
            <span class="emoji-icon">💩</span>
            <div class="rating-details">
              <span class="rating-label">Peggiore in campo</span>
              <strong class="player-name">{entry.data.worstPlayer}</strong>
            </div>
          </div>
        )}
      </div>

      <!-- SEZIONE GOL DELLA GIORNATA -->
      {entry.data.bestGoal && (
        <div class="rating-card best-goal">
          <span class="emoji-icon">⚽</span>
          <div class="rating-details">
            <span class="rating-label">Gol della giornata</span>
            <strong class="player-name">{entry.data.bestGoal}</strong>
          </div>
        </div>
      )}
    </div>
  )}

  <!-- BOX AUTORE -->
  {entry.data.author && entry.data.author.trim() !== "" && (
    <div class="author-box">
      <span class="author-badge">Autore</span>
      <div class="author-info">
        <div class="author-icon">
          <img src="/favicon.png" alt="Icona Autore" onerror="this.src='/favicon.svg'" />
        </div>
        <span class="author-name">{entry.data.author}</span>
      </div>
    </div>
  )}

</BaseLayout>

<style is:global>
  /* Pulsante "Torna alla Home" */
  .back-nav {
    margin-bottom: 25px;
  }
  .back-btn {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-weight: bold;
    color: #c0392b;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.85rem;
    display: inline-block;
    padding: 8px 14px;
    border: 2px solid #c0392b;
    border-radius: 4px;
    transition: background 0.3s, color 0.3s;
  }
  .back-btn:hover {
    background-color: #c0392b;
    color: #fff;
  }

  /* Intestazione articolo */
  .article-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid #ccc;
  }
  .matchday-tag {
    font-family: 'Helvetica', 'Arial', sans-serif;
    color: #c0392b;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    display: block;
    margin-bottom: 10px;
  }
  .main-title {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 2.4rem;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 15px 0;
    line-height: 1.1;
  }
  .main-subtitle {
    font-family: 'Georgia', serif;
    font-size: 1.2rem;
    color: #444;
    font-weight: normal;
    line-height: 1.4;
    margin: 0 0 15px 0;
  }
  .meta-data {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 0.9rem;
    color: #777;
  }

  /* Contenuto articolo */
  .article-content {
    line-height: 1.7;
    font-size: 1.2rem;
    color: #222;
  }
  .article-content p {
    margin-bottom: 20px;
  }
  
  .article-content img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 35px auto;
    border-radius: 4px;
  }

  /* STILE PER LE DIDASCALIE DELLE IMMAGINI */
  .article-content p:has(img) em {
    display: block;            /* Manda il testo a capo sotto l'immagine */
    text-align: center;        /* Centra il testo */
    font-size: 0.95rem;        /* Lo rende un po' più piccolo del testo normale */
    color: #666;             /* Colore grigio scuro, stile giornale */
    margin-top: -20px;         /* Avvicina la scritta all'immagine riducendo lo spazio */
    margin-bottom: 30px;       /* Dà respiro prima del paragrafo successivo */
    font-style: italic;        /* Font corsivo */
  }

    /* ========================================= */
  /* STILE GLOBALE DIDASCALIE VIDEO & MEDIA     */
  /* ========================================= */
  
  /* Stile per i tag <caption> usati sotto i video */
  .article-content caption,
  .article-content figcaption {
    display: block; /* Forza il tag a comportarsi come un paragrafo */
    font-family: 'Georgia', serif;
    font-size: 0.9rem;
    font-style: italic;
    color: #666;
    text-align: center;
    margin-top: 10px;
    margin-bottom: 25px;
    padding: 0 10px;
    line-height: 1.4;
  }

  /* STILI PER I SOTTOTITOLI NEL TESTO (## e ### nel Markdown) */
  .article-content h2 {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 1.6rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #111;
    margin-top: 45px;
    margin-bottom: 15px;
    border-bottom: 2px solid #eaeaea; 
    padding-bottom: 5px;
  }

  .article-content h3 {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
    color: #c0392b; 
    text-transform: uppercase;
    margin-top: 40px;
    margin-bottom: 15px;
  }
  
  .article-content h4 {
    font-family: 'Georgia', serif;
    font-size: 1.2rem;
    font-weight: bold;
    font-style: italic;
    color: #333;
    margin-top: 30px;
    margin-bottom: 10px;
  }

  /* ========================================= */
  /* STILI VOTI REDAZIONE & PREMI SPECIALI     */
  /* ========================================= */
  .match-ratings-container {
    margin-top: 50px;
    padding-top: 30px;
    border-top: 3px solid #111;
    margin-bottom: 80px; /* Spazio prima del box autore */
  }

  .ratings-title {
    font-family: 'Georgia', serif;
    font-size: 1.4rem;
    font-weight: bold;
    font-style: italic;
    color: #c0392b;
    text-align: center;
    margin-bottom: 30px;
    margin-top: 0;
    padding-bottom: 15px;
    border-bottom: 1px dotted #ccc; /* Sottile linea divisoria */
  }

  /* Contenitore per Top e Flop affiancati */
  .ratings-grid {
    display: flex;
    gap: 20px;
    justify-content: space-between;
    margin-bottom: 20px; /* Spazio prima dell'eventuale premio centrale */
  }

  /* Stile comune per tutti i riquadri premio */
  .rating-card {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 20px;
    border-radius: 8px;
    border-left: 6px solid;
    box-sizing: border-box; 
    width: 100%;
  }

  .top-player {
    background-color: #f0fdf4;
    border-left-color: #22c55e;
  }

  .worst-player {
    background-color: #fef2f2;
    border-left-color: #ef4444;
  }

  /* Stile per il Gol della giornata */
  .best-goal {
    background-color: #fdfaf0; /* Giallo/Oro molto chiaro */
    border-left-color: #eab308; /* Giallo scuro / Oro */
    margin: 0 auto; /* Lo centra se ha una larghezza massima */
    max-width: 450px; /* Gli impedisce di allargarsi troppo */
  }

  .emoji-icon {
    font-size: 3rem;
    margin-right: 20px;
  }

  .rating-details {
    display: flex;
    flex-direction: column;
  }

  .rating-label {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 0.85rem;
    font-weight: bold;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 5px;
  }

  .player-name {
    font-family: 'Georgia', serif;
    font-size: 1.3rem;
    font-weight: bold;
    color: #111;
  }

  /* ========================================= */
  /* STILI BOX AUTORE                          */
  /* ========================================= */
  .author-box {
    position: relative;
    background-color: #f0f2f5; 
    border-radius: 12px;
    padding: 20px 25px;
    margin-top: 40px;
    margin-bottom: 30px;
  }
  
  .author-badge {
    position: absolute;
    top: -12px; 
    left: 20px;
    background-color: #e91e63; /* Rosa acceso e leggibile */
    color: #fff;
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: 12px;
  }
  
  .author-info {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 5px;
  }
  
  .author-icon {
    width: 45px;
    height: 45px;
    background-color: #fff;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.08); 
    overflow: hidden;
  }
  
  .author-icon img {
    width: 25px;
    height: 25px;
    object-fit: contain;
  }
  
  .author-name {
    font-family: 'Helvetica', 'Arial', sans-serif;
    font-size: 1.1rem;
    font-weight: bold;
    color: #111;
  }

  @media (max-width: 600px) {

    .article-content {
      font-size: 1.05rem;
      line-height: 1.5;
    }
    
    .article-content p:has(img) em {
      font-size: 0.85rem;
      margin-bottom: 20px; 
    }

    .main-title {
      font-size: 2.2rem;
    }
    .main-subtitle {
      font-size: 1.2rem;
    }
    .article-content h2 {
      font-size: 1.4rem;
    }
    .article-content h3 {
      font-size: 1.15rem; 
    }

    .ratings-grid {
      flex-direction: column;
    }
    .best-goal {
      max-width: 100%;
      margin: 0;
    }

    .article-content caption,
    .article-content figcaption {
      font-size: 0.8rem;
      margin-bottom: 20px;
    }
  }
</style>